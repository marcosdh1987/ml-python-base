# Virtual environments
.venv/
venv/
env/
.env

# Local LiteLLM gateway config (holds real keys). The committed template is
# gateway/config.example.yaml.
gateway/config.yaml

# Python bytecode and build caches
*.pyc
*.pyo
*.pyd
__pycache__/
.Python
*.so

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Build and distribution
dist/
build/
*.egg-info/
.eggs/

# Linting, typing, and security reports
.mypy_cache/
.ruff_cache/
.pylint.d/
.pylintrc
security-report.json
bandit-report.json
semgrep-report.json

# IDEs and editors
# `.vscode/*`, not `.vscode/`: git cannot re-include a file whose parent
# directory is excluded, and the template ships one file there — the recommended
# Copilot agent-mode settings (the `git-actions` policy as VS Code auto-approve
# rules). Copy it to .vscode/settings.json to adopt it.
.vscode/*
!.vscode/settings.recommended.json
.idea/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints

# OS
.DS_Store
